# ─── Argos Configuration (.env) ──────────────────────────────
# Copy to .env and fill in values

# Environment: development | production
ARGOS_ENV=development

# ─── Database ─────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/argos.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://argos:password@postgres:5432/argos

# ─── Qdrant (Vector Database) ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Redis (Task Queue) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage ────────────────────────────────────────────
STORAGE_BACKEND=local           # local | s3 | minio
STORAGE_PATH=./data/files

# MinIO / S3 (if storage_backend=s3)
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=argos-files
# S3_REGION=us-east-1

# ─── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY=                  # 32-byte hex (generate: openssl rand -hex 32)
ENCRYPTION_ENABLED=true

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=                  # openssl rand -hex 64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Embedding Models ──────────────────────────────────────────
# Text embeddings (sentence-transformers)
TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Image embeddings (CLIP via transformers)
IMAGE_EMBEDDING_MODEL=openai/clip-vit-large-patch14
# Device: cpu | cuda | mps
EMBEDDING_DEVICE=cpu

# ─── Optional: Google Gemini Embedding 2 ───────────────────────
# GOOGLE_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ─── GLM-OCR ───────────────────────────────────────────────────
GLM_OCR_ENABLED=false
# GLM_OCR_MODEL_PATH=./models/glm-ocr

# ─── Whisper ────────────────────────────────────────────────────
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu

# ─── Limits ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1800
MAX_AUDIO_DURATION_SECONDS=3600
MAX_PDF_PAGES=500

# ─── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ─── Frontend ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
